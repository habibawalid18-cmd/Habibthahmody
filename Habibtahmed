<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Valentine for Ahmody</title>
  <style>
    body { 
      margin: 0; 
      font-family: 'Arial', sans-serif; 
      background: #ffd6e8; 
      display: flex; 
      justify-content: center; 
      align-items: center; 
      min-height: 100vh; 
      overflow: hidden; 
    }
    .heart { 
      position: absolute; 
      color: red; 
      font-size: 24px; 
      animation: fallHeart 6s linear infinite; 
      opacity: 0.8; 
      z-index: 0; 
    }
    @keyframes fallHeart { 
      0% { transform: translateY(-10vh); } 
      100% { transform: translateY(110vh); } 
    }
    .container { 
      text-align: center; 
      z-index: 1; 
      padding: 20px; 
      background: rgba(255, 255, 255, 0.4); 
      border-radius: 20px; 
      backdrop-filter: blur(5px); 
    }
    h1 { 
      font-size: 2.2rem; 
      margin-bottom: 20px; 
      color: #d63384; 
    }
    .message { 
      font-size: 1.2rem; 
      margin-bottom: 15px; 
      min-height: 28px; 
      color: #555; 
    }
    .buttons { 
      display: flex; 
      justify-content: center; 
      gap: 20px; 
      position: relative; 
    }
    button { 
      padding: 14px 32px; 
      font-size: 1.1rem; 
      border-radius: 30px; 
      border: none; 
      cursor: pointer; 
      transition: all 0.2s ease; 
      position: relative; 
    }
    #yesBtn { 
      background: linear-gradient(135deg, #ff6ec4, #c77dff); 
      color: white; 
      box-shadow: 0 4px 15px rgba(255, 110, 196, 0.4); 
      z-index: 10; 
    }
    #noBtn { 
      background: #ccc; 
      color: #333; 
      z-index: 5; 
    }
    .result { 
      display: none; 
      text-align: center; 
    }
    .result img { 
      max-width: 90%; 
      max-height: 70vh; 
      border-radius: 20px; 
      box-shadow: 0 10px 30px rgba(0,0,0,0.1); 
      border: 5px solid white; 
    }
    .confetti { 
      position: absolute; 
      width: 10px; 
      height: 10px; 
      z-index: 2; 
      animation: fall 3s linear forwards; 
    }
    @keyframes fall { 
      to { transform: translateY(100vh) rotate(720deg); opacity: 0; } 
    }
  </style>
</head>
<body>

  <div class="container" id="main">
    <h1>Ahmody, Will you be my Valentine?</h1>
    <div class="message" id="playfulMsg"></div>
    <div class="buttons" id="btnArea">
      <button id="yesBtn">Yes!</button>
      <button id="noBtn">No</button>
    </div>
  </div>

  <div class="container result" id="result">
    <img src="https://image2url.com/r2/default/images/1770847991438-ad01ae41-25fe-4e87-8eeb-eb26a6a85ebc.jpg" alt="Us" />
    <p style="color: #d63384; font-weight: bold; margin-top: 15px; font-size: 1.3rem;">
        WELL U HAD TO SAY YES ANYWAY<br/>
        P.S. FROM UR FAV FIANCEE HABOBA
    </p>
  </div>

  <audio id="yesSound" src="https://www.soundjay.com/human/sounds/applause-8.mp3"></audio>

  <script>
    // Falling hearts
    for (let i = 0; i < 25; i++) {
      const heart = document.createElement('div');
      heart.className = 'heart';
      heart.innerText = '❤';
      heart.style.left = Math.random() * 100 + 'vw';
      heart.style.animationDelay = Math.random() * 6 + 's';
      heart.style.fontSize = 18 + Math.random() * 26 + 'px';
      document.body.appendChild(heart);
    }

    const noBtn = document.getElementById('noBtn');
    const yesBtn = document.getElementById('yesBtn');
    const playfulMsg = document.getElementById('playfulMsg');
    const main = document.getElementById('main');
    const result = document.getElementById('result');
    const yesSound = document.getElementById('yesSound');

    let scale = 1;
    let msgIndex = 0;
    const messages = ["Are you sure? 😏", "Think again! 💖", "No is not an option 😂", "You're just making Yes stronger 💪❤️", "Last chance to escape 😈"];

    // Move "No" button when hovered
    noBtn.addEventListener('mouseover', () => {
      const x = Math.random() * (window.innerWidth - noBtn.offsetWidth) - (window.innerWidth / 2 - noBtn.offsetLeft);
      const y = Math.random() * (window.innerHeight - noBtn.offsetHeight) - (window.innerHeight / 2 - noBtn.offsetTop);
      noBtn.style.transform = `translate(${x}px, ${y}px)`;
    });

    // Scale "Yes" button when "No" is clicked
    noBtn.addEventListener('click', () => {
      scale *= 1.4;
      yesBtn.style.transform = `scale(${scale})`;
      playfulMsg.innerText = messages[msgIndex % messages.length];
      msgIndex++;
    });

    // When "Yes" is clicked
    yesBtn.addEventListener('click', async () => {
      try {
        await yesSound.play();
      } catch (e) {
        console.log("Audio blocked, click allowed it.");
      }

      main.style.display = 'none';
      result.style.display = 'block';

      // Launch confetti
      for (let i = 0; i < 80; i++) {
        const conf = document.createElement('div');
        conf.className = 'confetti';
        conf.style.left = Math.random() * 100 + 'vw';
        conf.style.top = '-10px';
        conf.style.background = `hsl(${Math.random() * 360}, 100%, 70%)`;
        conf.style.animationDuration = 2 + Math.random() * 2 + 's';
        document.body.appendChild(conf);
        setTimeout(() => conf.remove(), 4000);
      }
    });
  </script>
</body>
</html>
